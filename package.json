{
  "name": "@sudobility/sudojo_lib",
  "version": "0.0.213",
  "description": "Business logic library for Sudojo app",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:coverage:threshold": "vitest run --coverage --reporter=verbose",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check-all": "bun run lint && bun run typecheck && bun run test:unit",
    "quick-check": "bun run lint && bun run typecheck",
    "dev": "bun run build:watch"
  },
  "keywords": [
    "sudojo",
    "typescript",
    "library",
    "dependency-injection"
  ],
  "author": "Sudobility team",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@sudobility/di": "^1.5.77",
    "@sudobility/sudojo_client": "^0.0.171",
    "@sudobility/sudojo_types": "^1.2.78",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitest/coverage-v8": "~4.1.12",
    "@vitest/ui": "~4.1.12",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "happy-dom": "~20.14.6",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vitest": "~4.1.12",
    "zustand": "~5.0.16"
  },
  "peerDependencies": {
    "@sudobility/di": "^1.5.77",
    "@sudobility/sudojo_client": "^0.0.171",
    "@sudobility/sudojo_types": "^1.2.78",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/sudojo_lib.git"
  }
}
